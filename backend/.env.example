# ═══════════════════════════════════════════════════════════════════════════════
# JoyFund Backend - Environment Variables
# ═══════════════════════════════════════════════════════════════════════════════
#
# This file defines ALL environment variables needed for the Django backend.
# Copy this file to .env and update values for your environment.
#
# IMPORTANT:
# - NEVER commit actual .env files to Git
# - Keep this file up-to-date with all required variables
# - Use strong, random values for secrets in production
#
# ═══════════════════════════════════════════════════════════════════════════════

# ─── DJANGO CORE SETTINGS ──────────────────────────────────────────────────────

# Django secret key (generate with: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())')
# CRITICAL: Use a unique, random value in production
SECRET_KEY=django-insecure-your-secret-key-here

# Debug mode (MUST be False in production)
DEBUG=False

# Allowed hosts (comma-separated domain names)
# Production example: api.joyfund.cm,www.joyfund.cm,joyfund.cm
# Local development: localhost,127.0.0.1
ALLOWED_HOSTS=localhost,127.0.0.1,joyfund_web_1,joyfund_web_2

# ─── DATABASE CONFIGURATION ───────────────────────────────────────────────────
# Option 1: DATABASE_URL (recommended for Docker and managed services like Heroku/Neon)
# DATABASE_URL=postgresql://user:password@host:5432/joyfund_prod

# Option 2: Individual database settings (used if DATABASE_URL not set)
DB_ENGINE=django.contrib.gis.db.backends.postgis
DB_NAME=joyfund
DB_USER=joyfund
DB_PASSWORD=joyfund-secure-password-here
DB_HOST=joyfund_postgres
DB_PORT=5432
DB_CONN_MAX_AGE=600

# ─── CACHE & REDIS CONFIGURATION ──────────────────────────────────────────────

# Redis cache URL
CACHE_LOCATION=redis://joyfund_redis:6379/2

# ─── MESSAGE BROKER & ASYNC TASKS (Celery) ─────────────────────────────────────

# RabbitMQ broker URL for Celery task queue
CELERY_BROKER_URL=amqp://joyfund:joyfund@joyfund_rabbitmq:5672//

# Redis backend for Celery results
CELERY_RESULT_BACKEND=redis://joyfund_redis:6379/1

# ─── WEBSOCKET CONFIGURATION (Django Channels) ─────────────────────────────────

# Redis channel layer host for WebSocket support
CHANNEL_LAYER_HOST=redis://joyfund_redis:6379/0

# ─── STATIC & MEDIA FILES ──────────────────────────────────────────────────────

# Use S3-compatible storage (Backblaze B2) for media files
USE_S3=False

# B2 (Backblaze) S3-compatible credentials (only if USE_S3=True)
# Sign up at https://www.backblaze.com/b2/cloud-storage.html
B2_ACCESS_KEY_ID=your-b2-access-key
B2_SECRET_ACCESS_KEY=your-b2-secret-key
B2_STORAGE_BUCKET_NAME=joyfund-media
B2_S3_REGION_NAME=us-west-000

# ─── EMAIL CONFIGURATION ───────────────────────────────────────────────────────

# SMTP email backend for sending emails
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# Gmail SMTP settings (change if using different email provider)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True

# Gmail app password (not your regular password)
# Generate at: https://myaccount.google.com/apppasswords
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password

# Default sender for system emails
DEFAULT_FROM_EMAIL=noreply@joyfund.cm

# ─── PAYMENT GATEWAY CONFIGURATION ─────────────────────────────────────────────

# CamPay Mobile Money Payment Gateway (for Cameroon)
# Sign up at https://campay.net/
CAMPAY_APP_ID=your-campay-app-id
CAMPAY_APP_USERNAME=your-campay-username
CAMPAY_APP_PASSWORD=your-campay-password
CAMPAY_PERMANENT_TOKEN=your-campay-token
CAMPAY_WEBHOOK_SECRET=your-campay-webhook-secret
CAMPAY_ENVIRONMENT=DEV  # Use "PROD" in production

# ─── SMS GATEWAY CONFIGURATION ─────────────────────────────────────────────────

# Twilio SMS service (for OTP and notifications)
# Sign up at https://www.twilio.com/
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890  # Your Twilio phone number

# ─── AUTHENTICATION & OAUTH2 ──────────────────────────────────────────────────

# OAuth2 Access token expiration (in seconds)
OAUTH2_ACCESS_TOKEN_EXPIRE_SECONDS=3600  # 1 hour

# Google OAuth2 (for social authentication)
# Set up at: Google Cloud Console → Credentials
SOCIAL_AUTH_GOOGLE_OAUTH2_KEY=your-google-oauth-key
SOCIAL_AUTH_GOOGLE_OAUTH2_SECRET=your-google-oauth-secret
SOCIAL_AUTH_GOOGLE_OAUTH2_WHITELISTED_DOMAINS=joyfund.cm,localhost

# ─── WEB PUSH NOTIFICATIONS (VAPID) ──────────────────────────────────────────

# Web push notification keys for service workers
# Generate with: npm install -g web-push && web-push generate-vapid-keys
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_PUBLIC_KEY=your-vapid-public-key

# ─── FRONTEND CONFIGURATION ────────────────────────────────────────────────────

# Frontend URL (used for password reset links, email confirmations)
FRONTEND_URL=https://joyfund.cm

# ─── LOGGING & MONITORING ─────────────────────────────────────────────────────

# Django logging level
DJANGO_LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL

# Sentry error tracking (optional but recommended for production)
# Sign up at https://sentry.io/
SENTRY_DSN=https://your-sentry-key@your-org.ingest.sentry.io/your-project-id

# ─── GRAFANA & MONITORING ─────────────────────────────────────────────────────

# Grafana admin credentials
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=grafana-secure-password-here

# ─── PGADMIN (DATABASE ADMIN UI) ───────────────────────────────────────────────

# pgAdmin credentials (for database management)
PGADMIN_DEFAULT_EMAIL=admin@joyfund.cm
PGADMIN_DEFAULT_PASSWORD=pgadmin-secure-password-here

# ─── GEOSPATIAL LIBRARIES (Optional) ───────────────────────────────────────────

# Paths to geospatial libraries (usually auto-detected, override if needed)
# GDAL_LIBRARY_PATH=/path/to/libgdal.so
# GEOS_LIBRARY_PATH=/path/to/libgeos_c.so
# SPATIALITE_LIBRARY_PATH=/usr/lib/x86_64-linux-gnu/mod_spatialite.so.8.1.0

# ═══════════════════════════════════════════════════════════════════════════════
# QUICK REFERENCE - REQUIRED vs OPTIONAL
# ═══════════════════════════════════════════════════════════════════════════════
#
# REQUIRED for Production:
#   - SECRET_KEY (unique, random value)
#   - DEBUG=False
#   - DATABASE_URL or DB_* variables
#   - EMAIL_* variables
#   - FRONTEND_URL
#   - CELERY_BROKER_URL
#   - CELERY_RESULT_BACKEND
#   - ALLOWED_HOSTS (your domain names)
#
# STRONGLY RECOMMENDED:
#   - SENTRY_DSN (error tracking)
#   - VAPID_* keys (push notifications)
#   - CAMPAY_* (payment processing)
#   - TWILIO_* (SMS notifications)
#
# OPTIONAL:
#   - USE_S3 / B2_* (file storage)
#   - SOCIAL_AUTH_GOOGLE_OAUTH2_* (Google login)
#   - GRAFANA_* (monitoring - auto-defaults)
#   - GDAL_/GEOS_/SPATIALITE_* (usually auto-detected)
#
# ═══════════════════════════════════════════════════════════════════════════════
# DOCKER COMPOSE USAGE
# ═══════════════════════════════════════════════════════════════════════════════
#
# Development:
#   docker compose -f docker-compose.yml --env-file .env up
#
# Production:
#   docker compose -f prod.yml --env-file ./envs/prod/.env up --build -d
#
# ═══════════════════════════════════════════════════════════════════════════════
