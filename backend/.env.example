# ──────────────────────────────────────────────────────────────────────────────
# JoyFund-PHIF  –  Environment variables
# Copy this file to .env and fill in the values before running Docker.
# NEVER commit the real .env file to version control.
# ──────────────────────────────────────────────────────────────────────────────

# ── Django ────────────────────────────────────────────────────────────────────
SECRET_KEY=replace-me-with-a-long-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost 127.0.0.1 0.0.0.0

# ── Database (PostGIS / PostgreSQL) ───────────────────────────────────────────
DB_ENGINE=django.contrib.gis.db.backends.postgis
DB_NAME=joyfund
DB_USER=joyfund
DB_PASSWORD=strongpassword
DB_HOST=db
DB_PORT=5432
DB_CONN_MAX_AGE=600

# ── Celery (RabbitMQ Broker) ──────────────────────────────────────────────────
CELERY_BROKER_URL=amqp://joyfund:joyfund@rabbitmq:5672//
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ── Redis (Caching) ───────────────────────────────────────────────────────────
CACHE_LOCATION=redis://redis:6379/2
REDIS_HOST=redis

# ── API Configuration (Pagination & Rate Limiting) ────────────────────────────
REST_PAGE_SIZE=20
THROTTLE_ANON=100/hour
THROTTLE_USER=1000/hour

# ── Logging ───────────────────────────────────────────────────────────────────
DJANGO_LOG_LEVEL=INFO
# Log retention policies (days)
LOG_RETENTION_DAYS=90
LOG_REQUEST_RETENTION_DAYS=30

# ── OAuth2 Settings ───────────────────────────────────────────────────────────
OAUTH2_ACCESS_TOKEN_EXPIRE_SECONDS=36000

# ── Email Configuration ───────────────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@joyfund.com

# ── Google OAuth2 (Optional) ──────────────────────────────────────────────────
SOCIAL_AUTH_GOOGLE_OAUTH2_KEY=your-google-key
SOCIAL_AUTH_GOOGLE_OAUTH2_SECRET=your-google-secret
SOCIAL_AUTH_GOOGLE_OAUTH2_WHITELISTED_DOMAINS=yourdomain.com

# ── Media / Static ────────────────────────────────────────────────────────────
# These are set in settings.py relative to BASE_DIR; override here if needed.
# MEDIA_ROOT=/app/media
# STATIC_ROOT=/app/static


FRONTEND_URL=http://localhost:3000


# BACKBLAZE B2 Cloud Storage ─────────────────────────────────────────
B2_ACCESS_KEY_ID=
B2_SECRET_ACCESS_KEY=
B2_STORAGE_BUCKET_NAME=
B2_S3_REGION_NAME=


# CAMPAY API
CAMPAY_APP_ID=
CAMPAY_APP_USERNAME=
CAMPAY_APP_PASSWORD=
CAMPAY_WEBHOOK_SECRET=
CAMPAY_ENVIRONMENT=DEV