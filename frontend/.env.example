# ═══════════════════════════════════════════════════════════════════════════════
# JoyFund Frontend - Environment Variables
# ═══════════════════════════════════════════════════════════════════════════════
#
# This file defines all environment variables needed for the frontend application.
# Copy this file to .env (or .env.local for local overrides) and update values.
#
# IMPORTANT:
# - Variables starting with NEXT_PUBLIC_ are visible to the browser
# - Other variables are server-side only
# - NEVER commit actual .env files to Git
# ═══════════════════════════════════════════════════════════════════════════════

# ─── PUBLIC API Configuration (Visible to Browser) ──────────────────────────────
# These NEXT_PUBLIC_* variables are baked into the frontend at build time
# Available to both server and client code

# Django REST API base URL (without trailing slash)
NEXT_PUBLIC_DJANGO_API_URL=http://localhost:8000/api

# Django backend URL (for OAuth redirects, admin links)
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# OAuth2 Client Credentials
# Get these from: Django Admin → OAuth2 (oauth2_provider) → Applications
NEXT_PUBLIC_DJANGO_OAUTH_CLIENT_ID=your-oauth-client-id-here
NEXT_PUBLIC_DJANGO_OAUTH_CLIENT_SECRET=your-oauth-client-secret-here

# Error tracking service (Sentry)
NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-key@your-sentry-org.ingest.sentry.io/your-project-id

# Feature flags (optional)
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_EXPERIMENTS=false

# ─── Server-Side Only (Not visible to browser) ────────────────────────────────
# These variables are only available during build time and server-side routes
# Safe place for secrets

# Node environment
NODE_ENV=development

# Enable debug logging
DEBUG=false

# Database connection (if needed server-side)
DATABASE_URL=postgresql://user:password@localhost:5432/joyfund

# ─── Application Settings ─────────────────────────────────────────────────────

# Application name/version
APP_NAME=JoyFund
APP_VERSION=1.0.0

# Port for Next.js server
PORT=3000

# Hostname for Next.js server
HOSTNAME=0.0.0.0

# ═══════════════════════════════════════════════════════════════════════════════
# PRODUCTION DEPLOYMENT NOTES
# ═══════════════════════════════════════════════════════════════════════════════
#
# For production deployment via Docker:
#
# 1. Build arguments (passed at build time):
#    docker build \
#      --build-arg NEXT_PUBLIC_DJANGO_API_URL=https://api.joyfund.cm/api \
#      --build-arg NEXT_PUBLIC_BACKEND_URL=https://api.joyfund.cm \
#      --build-arg NEXT_PUBLIC_DJANGO_OAUTH_CLIENT_ID=prod-client-id \
#      --build-arg NEXT_PUBLIC_DJANGO_OAUTH_CLIENT_SECRET=prod-secret \
#      -t joyfund-frontend:latest .
#
# 2. Or use environment variables in docker-compose:
#    frontend:
#      environment:
#        NEXT_PUBLIC_DJANGO_API_URL: https://api.joyfund.cm/api
#        NEXT_PUBLIC_BACKEND_URL: https://api.joyfund.cm
#
# 3. Variables are baked into the Next.js build (.next/standalone)
#    No .env files are needed at runtime
#
# ═══════════════════════════════════════════════════════════════════════════════
