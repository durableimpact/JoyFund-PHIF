# JoyFund Frontend Local Environment Overrides
# This file demonstrates how to override .env.example for local development
# Copy to .env.local to use (this file is tracked in Git, .env.local is not)

# Use this file to override variables from .env.example for your local machine
# This is useful when:
# - Running API on a different host/port
# - Testing against a different backend
# - Using local service with custom configuration

# Example: If your Django API is on a different machine
# NEXT_PUBLIC_DJANGO_API_URL=http://192.168.1.100:8000/api

# Example: If testing against production API (local frontend only)
# NEXT_PUBLIC_DJANGO_API_URL=https://api.joyfund.cm/api
# NEXT_PUBLIC_BACKEND_URL=https://api.joyfund.cm

# Example: Debug mode for local development
# DEBUG=true

# Example: Use different OAuth credentials for local testing
# NEXT_PUBLIC_DJANGO_OAUTH_CLIENT_ID=local-test-client-id
# NEXT_PUBLIC_DJANGO_OAUTH_CLIENT_SECRET=local-test-client-secret
