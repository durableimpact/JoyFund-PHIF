# ────────────────────────────────────────────────────────────────
# AUTHENTICATION - SECURE CONFIGURATION
# ────────────────────────────────────────────────────────────────

# ⚠️ CRITICAL: These MUST be server-side only (NO NEXT_PUBLIC_ prefix)
# These credentials MUST NEVER be exposed to the client
# They are only used in app/api/auth/refresh/route.ts and NextAuth callbacks

DJANGO_OAUTH_CLIENT_ID=your_client_id_here
DJANGO_OAUTH_CLIENT_SECRET=your_client_secret_here

# NextAuth secret for signing JWTs (generate with: openssl rand -hex 32)
AUTH_SECRET=your_generated_auth_secret_here

# ────────────────────────────────────────────────────────────────
# CLIENT-SIDE CONFIGURATION (publicly visible)
# ────────────────────────────────────────────────────────────────

# Django API base URL (used by client for API calls)
NEXT_PUBLIC_DJANGO_API_URL=http://localhost:8000

# ────────────────────────────────────────────────────────────────
# OTHER SERVICES
# ────────────────────────────────────────────────────────────────

NEXT_PUBLIC_SENTRY_DSN=your_sentry_dsn_here
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=your_ga_id_here

# ────────────────────────────────────────────────────────────────
# IMPORTANT NOTES
# ────────────────────────────────────────────────────────────────
# 
# 1. NEVER commit .env.local to version control
# 2. Variables starting with NEXT_PUBLIC_ are exposed to the browser
# 3. Server-side variables are only available in API routes and server actions
# 4. Token refresh is now handled server-side in /app/api/auth/refresh/route.ts
# 5. The client-side token-refresh-provider has been removed
#
